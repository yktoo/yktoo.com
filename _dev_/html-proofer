#!/bin/bash
# Runs HTMLProofer over the generated site in a stock Ruby container, using the Ruby version from .ruby-version and the
# gems pinned in Gemfile.lock, so the checks match CI without a local Ruby install.
project_dir="$(dirname "$(dirname "$(realpath "$0")")")"

err() {
    echo "$1" >&2
    exit 1
}

# Verify there's a generated site
[[ -d "$project_dir/public" ]] || err "Run hugo first to build the site"

ruby_version="$(<"$project_dir/.ruby-version")" || err "Failed to read .ruby-version"

# Run HTMLProofer. The project is mounted read-only, so the Gemfile and lockfile are copied out; BUNDLE_FROZEN makes
# Bundler fail instead of re-resolving if the two disagree
docker run \
    --rm \
    -v "$project_dir":/src:ro \
    -w /work \
    -e BUNDLE_FROZEN=true \
    "ruby:$ruby_version" \
    bash -c '
        cp /src/Gemfile /src/Gemfile.lock . &&
        bundle install --quiet &&
        bundle exec htmlproofer /src/public \
            --allow-missing-href \
            --checks              Links,Images,Scripts,Favicon,OpenGraph \
            --disable-external \
            --no-enforce-https \
            --ignore-empty-mailto'
